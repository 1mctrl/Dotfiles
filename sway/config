
### ---------------------------------------------------------
###  0) Environment / portals / services
### ---------------------------------------------------------

# Export session vars for systemd user services (portals, etc.)
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# xdg-desktop-portal stack (order matters less, but keep grouped)
exec_always --no-startup-id /usr/libexec/xdg-desktop-portal
exec_always --no-startup-id /usr/libexec/xdg-desktop-portal-wlr
exec_always --no-startup-id /usr/libexec/xdg-desktop-portal-gtk
# pipewire
exec /usr/libexec/pipewire-launcher &
#xsettings
exec xsettingsd
# Bluetooth tray
#exec_always --no-startup-id blueman-applet
# Battery
exec ~/.local/bin/battery-watch.sh &

### ---------------------------------------------------------
###  1) Variables
### ---------------------------------------------------------

set $mod   Mod4

set $left  n
set $down  k
set $up    l
set $right e

set $term  foot


### ---------------------------------------------------------
###  2) Outputs / wallpaper
### ---------------------------------------------------------

output * bg /home/icon/pics/mountain1.jpg fill


### ---------------------------------------------------------
###  3) Bar
### ---------------------------------------------------------

#bar {
#    swaybar_command waybar
#}
bar {
    position bottom

    status_command ~/stat/axbr
    
    colors {
        statusline #ffdddd
        background #1F2128
        inactive_workspace #32323200 #32323200 #5c5c5c
    }
}

bar {
    position top
    status_command ~/.config/sway/status/logs-up.sh
    workspace_buttons no
    colors {
           background       #1F2128
	   statusline       #ffdddd
           separator        #444466

    }
}
### ---------------------------------------------------------
###  4) Idle / lock / DPMS / cursor hide
### ---------------------------------------------------------

#exec swayidle -w \
#    timeout 500 'swaylock --image /home/icon/pics/wave.png' \
#    timeout 500 'swaymsg "output * dpms off"' resume 'swaymsg "output * dpms on"' \
#    before-sleep 'swaylock --image /home/icon/pics/wave.png'

seat * hide_cursor 10000


xwayland enable

### ---------------------------------------------------------
###  7) Colors
### ---------------------------------------------------------

set $bg-color            #5B6176
set $inactive-bg-color   #1F2128
set $text-color          #ffffff
set $inactive-text-color #777777
set $urgent-bg-color     #dc322f

#                       border              background         text                 indicator
client.focused          $bg-color           $bg-color          $text-color          $bg-color
client.unfocused        $inactive-bg-color  $inactive-bg-color $inactive-text-color $inactive-bg-color
client.focused_inactive $inactive-bg-color  $inactive-bg-color $inactive-text-color $inactive-bg-color
client.urgent           $urgent-bg-color    $urgent-bg-color   $text-color          $urgent-bg-color


### ---------------------------------------------------------
###  8) Input (keyboard / touchpad)
### ---------------------------------------------------------

input * {
    xkb_layout us,ru
    xkb_variant colemak,
    xkb_options grp:alt_space_toggle
    repeat_delay 200
    repeat_rate 50
    
    
}

input "2:7:SynPS/2_Synaptics_TouchPad" {
    events disabled
}


### ---------------------------------------------------------
###  9) Core binds (apps / session)
### ---------------------------------------------------------

bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym $mod+d exec rofi -show drun
bindsym $mod+Shift+d exec rofi -show run

bindsym $mod+Shift+r reload
bindsym $mod+Shift+x exec swaynag -t warning -m 'exit sway? ' -B 'Yes' 'swaymsg exit'
bindsym $mod+Shift+z exec swaylock --image /home/icon/pics/mountain1.jpg


### ---------------------------------------------------------
### 10) Media / brightness keys
### ---------------------------------------------------------

bindsym XF86AudioMute         exec pactl set-sink-mute   @DEFAULT_SINK@ toggle
bindsym XF86AudioRaiseVolume  exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume  exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMicMute      exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

bindsym XF86MonBrightnessUp   exec brightnessctl s +5%
bindsym XF86MonBrightnessDown exec brightnessctl s 5%-


### ---------------------------------------------------------
### 11) Focus / move (hjkl-style + arrows)
### ---------------------------------------------------------

# Focus (your custom keys)
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right

# Focus (arrows)
bindsym $mod+Left   focus left
bindsym $mod+Down   focus down
bindsym $mod+Up     focus up
bindsym $mod+Right  focus right

# Move (your custom keys)
bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right

# Move (arrows)
bindsym $mod+Shift+Left   move left
bindsym $mod+Shift+Down   move down
bindsym $mod+Shift+Up     move up
bindsym $mod+Shift+Right  move right


### ---------------------------------------------------------
### 12) Layout / floating / scratchpad
### ---------------------------------------------------------

bindsym $mod+b splith
bindsym $mod+v splitv

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+p layout toggle split

bindsym $mod+f fullscreen

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show


### ---------------------------------------------------------
### 13) Screenshots / recording
### ---------------------------------------------------------

# Toggle wf-recorder (SIGINT if running; else start)
bindsym $mod+Shift+w exec pkill -INT wf-recorder || \
    (notify-send "Recording started" && \
     wf-recorder -f ~/Videos/rec_$(date +%F_%T).mp4 && \
     notify-send "Recording saved")

# Screenshot to clipboard (region)
bindsym $mod+g exec grim -g "$(slurp)" - | wl-copy --type image/png

# Screenshot to file (region)
bindsym $mod+Shift+g exec grim -g "$(slurp)"


### ---------------------------------------------------------
### 14) Workspaces (numbers 0..9)
### ---------------------------------------------------------

bindsym $mod+1 workspace number 0
bindsym $mod+2 workspace number 1
bindsym $mod+3 workspace number 2
bindsym $mod+4 workspace number 3
bindsym $mod+5 workspace number 4
bindsym $mod+6 workspace number 5
bindsym $mod+7 workspace number 6
bindsym $mod+8 workspace number 7
bindsym $mod+9 workspace number 8
bindsym $mod+0 workspace number 9

bindsym $mod+Shift+1 move container to workspace number 0
bindsym $mod+Shift+2 move container to workspace number 1
bindsym $mod+Shift+3 move container to workspace number 2
bindsym $mod+Shift+4 move container to workspace number 3
bindsym $mod+Shift+5 move container to workspace number 4
bindsym $mod+Shift+6 move container to workspace number 5
bindsym $mod+Shift+7 move container to workspace number 6
bindsym $mod+Shift+8 move container to workspace number 7
bindsym $mod+Shift+9 move container to workspace number 8
bindsym $mod+Shift+0 move container to workspace number 9


### ---------------------------------------------------------
### 15) Resize mode
### ---------------------------------------------------------

mode "resize" {
    bindsym $left  resize shrink width 10px
    bindsym $down  resize grow height 10px
    bindsym $up    resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left   resize shrink width 10px
    bindsym Down   resize grow height 10px
    bindsym Up     resize shrink height 10px
    bindsym Right  resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"


### ---------------------------------------------------------
### 16) External layered includes
### ---------------------------------------------------------

include '$(/usr/libexec/sway/layered-include "/usr/share/sway/config.d/*.conf" "/etc/sway/config.d/*.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf")'
